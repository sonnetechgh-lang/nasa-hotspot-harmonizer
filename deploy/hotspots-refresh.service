# Host-side daily refresh: download -> normalize -> grid inside the container, then restart it
# so it loads the new data. Calibration is NOT re-run here (only on purpose, by hand).
# Install: cp deploy/hotspots-refresh.* /etc/systemd/system/ && systemctl enable --now hotspots-refresh.timer
[Unit]
Description=Refresh FIRMS hotspot data for the burning calendar
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec hotspots_app /app/deploy/refresh.sh
# Only runs if the refresh succeeded; Caddy holds requests during the few seconds of restart
ExecStartPost=/usr/bin/docker restart hotspots_app
TimeoutStartSec=2h
