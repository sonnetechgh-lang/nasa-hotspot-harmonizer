# Daily data refresh: download -> normalize -> grid, then restart the app so it loads the new data.
# Calibration is NOT re-run here (only on purpose, by hand).
[Unit]
Description=Refresh FIRMS hotspot data for the burning calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hotspots
Group=hotspots
WorkingDirectory=/opt/nasa-hotspot-harmonizer
ExecStart=/opt/nasa-hotspot-harmonizer/deploy/refresh.sh
# "+" = run as root. Only runs if the refresh succeeded: restart the app, empty nginx's API cache.
ExecStartPost=+/bin/systemctl restart hotspots.service
ExecStartPost=+/bin/sh -c "rm -rf /var/cache/nginx/hotspots/*"
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# DuckDB may spill temp files into the working directory, so the app folder stays writable
ReadWritePaths=/opt/nasa-hotspot-harmonizer
