# Web app + API (uvicorn behind nginx). Installed to /etc/systemd/system/ by setup.sh.
[Unit]
Description=Ghana burning activity calendar (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=hotspots
Group=hotspots
WorkingDirectory=/opt/nasa-hotspot-harmonizer
# One worker: the app keeps its data and caches in memory
ExecStart=/opt/nasa-hotspot-harmonizer/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5
MemoryMax=1800M
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# DuckDB may spill temp files into the working directory, so the app folder stays writable
ReadWritePaths=/opt/nasa-hotspot-harmonizer

[Install]
WantedBy=multi-user.target
